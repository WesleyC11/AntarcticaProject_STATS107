library(lubridate)
library(dplyr)
library(ggplot2)
# 1. Read the datasets directly
weather    <- read.csv("Monthly_Weather_Clean.csv")
seaicearea <- read.csv("SeaIceArea_Clean.csv")
seaiceconc <- read.csv("SeaIceConc_Clean.csv")
# 2. Process Weather Data (keeping full history)
weather_clean <- weather %>%
mutate(Date = as.Date(Date, format = "%m/%d/%Y")) %>%
select(
Date,
Surface_Temp = Mean_Temperature_C,
Mean_SST_C = Mean_Sea_Surface_Temperature_C
)
# 3. Process Sea Ice Area Data (filter for WAP subregion and build valid Date format)
seaicearea_clean <- seaicearea %>%
filter(Subregion == "WAP") %>%
mutate(Date = as.Date(paste(Year, Month, "01", sep = "-"), format = "%Y-%m-%d")) %>%
select(Date, Sea_Ice_Area = Sea_ice_area)
# 4. Process Sea Ice Concentration Data (isolating Anv subregion near Palmer station)
seaiceconc_clean <- seaiceconc %>%
filter(Subregion == "Anv") %>%
mutate(Date = as.Date(paste(Year, Month, "01", sep = "-"), format = "%Y-%m-%d")) %>%
select(Date, Sea_Ice_Conc = Mean_sea_ice_conc)
# 5. Join into a master dataframe using exact calendar dates
project_data <- weather_clean %>%
left_join(seaicearea_clean, by = "Date") %>%
left_join(seaiceconc_clean, by = "Date") %>%
mutate(
Sea_Ice_Area = as.numeric(Sea_Ice_Area),
Sea_Ice_Conc = as.numeric(Sea_Ice_Conc)
)
ggplot(project_data, aes(x = Date, y = Mean_SST_C)) +
geom_line(color = "darkcyan", linewidth = 0.6) +
geom_smooth(method = "lm", color = "black", linetype = "dashed", se = FALSE) +
labs(
title = "Monthly Mean Sea Surface Temperature (SST) vs. Time",
subtitle = "WAP Region (1993-2023) with Linear Regression Line",
x = "Year",
y = "Mean Sea Surface Temperature (°C)"
) +
theme_minimal()
# Output trend matrix metrics
sst_time_model <- lm(Mean_SST_C ~ Date, data = project_data)
summary(sst_time_model)$coefficients
ggplot(project_data, aes(x = Sea_Ice_Area, y = Surface_Temp)) +
geom_point(alpha = 0.6, color = "purple") +
geom_smooth(method = "lm", color = "black", linewidth = 1) +
labs(
title = "Surface Temperature vs. Sea Ice Area",
subtitle = "WAP Region Timeline (1993-2023)",
x = "Monthly Sea Ice Area (km²)",
y = "Monthly Mean Surface Temperature (°C)"
) +
theme_minimal()
# Quantify trend statistics
area_temp_model <- lm(Surface_Temp ~ Sea_Ice_Area, data = project_data)
summary(area_temp_model)$coefficients
ggplot(project_data, aes(x = Sea_Ice_Conc, y = Surface_Temp)) +
geom_point(alpha = 0.6, color = "darkblue") +
geom_smooth(method = "lm", color = "red", linewidth = 1) +
labs(
title = "Surface Temperature vs. Sea Ice Concentration",
subtitle = "Anv Subregion Profile (1993-2023)",
x = "Mean Sea Ice Concentration (%)",
y = "Monthly Mean Surface Temperature (°C)"
) +
theme_minimal()
