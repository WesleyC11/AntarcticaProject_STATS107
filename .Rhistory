install.packages(c("ggplot2", "dplyr", "rmarkdown"))
library(ggplot2)
library(dplyr)
sea_ice <- read.csv("SeaIceConc_Clean.csv")
head(sea_ice)
sea_ice_clean <- sea_ice %>%
filter(Subregion %in% c("Anv", "Avi")) %>%
filter(!is.na(Mean_sea_ice_conc)) %>%
group_by(Year, Subregion) %>%
summarise(
mean_concentration = mean(Mean_sea_ice_conc),
months_observed = n(),
.groups = "drop"
) %>%
filter(months_observed == 12)
head(sea_ice_clean)
sea_ice_plot <- ggplot(
sea_ice_clean,
aes(
x = Year,
y = mean_concentration,
color = Subregion
)
) +
geom_line(linewidth = 1) +
labs(
title = "Sea Ice Concentration vs Time",
subtitle = "Comparison of Anv and Avi Antarctic Subregions",
x = "Year",
y = "Annual Mean Sea Ice Concentration (%)",
color = "Region"
) +
theme_minimal()
print(sea_ice_plot)
