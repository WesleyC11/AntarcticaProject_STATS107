##First, the cleaned .csv files are read into the global environment:
weather <- read.csv("Monthly_Weather_Clean.csv")
seaicearea <- read.csv("SeaIceArea_Clean.csv")
seaiceconc <- read.csv("SeaIceConc_Clean.csv")
##Then, we need to subset the data for mean temperatures for all years from 1979 to 2023, as these are the full years that we have data for (not parts of years):
weather_subset <- weather[, c("Date", "Mean_Temperature_C")]
View(weather_subset)
weather_subset$Date = as.Date(weather_subset$Date, format = "%m/%d/%Y")
weathergooddates <- weather_subset[weather_subset$Date >= as.Date("1979-01-01") & weather_subset$Date <= as.Date("2023-12-01") ]
weather_subset$Date = as.Date(weather_subset$Date, format = "%m/%d/%Y")
weathergooddates <- weather_subset[weather_subset$Date >= as.Date("1979-01-01") & weather_subset$Date <= as.Date("2023-12-01") ]
weathergooddates <- weather_subset[weather_subset$Date >= as.Date("1979-01-01") & weather_subset$Date <= as.Date("2023-12-01"), ]
weathergooddates <- weather_subset[
weather_subset$Date >= as.Date("1979-01-01") &
weather_subset$Date <= as.Date("2023-12-01"),]
View(weathergooddates)
seaicearea_WAP <- seaicearea[seaicearea$Subregion == "WAP", ]
View(seaicearea_WAP)
seaicearea_subsetWAP <- seaicearea_WAP[, c("Year", "Month", "Sea_ice_area")]
seaicearea_WAPdates <- seaicearea_subsetWAP[seaicearea_subsetWAP$Year >= 1979 & seaicearea_subsetWAP$Year <= 2023, ]
weathergraph1 <- weathergooddates$Mean_Temperature_C
seaiceareagraph1 <- seaicearea_WAPdates$Sea_ice_area
##Both of the vectors we will graph have to be numerics, so check here!
seaiceareagraph1 <- as.numeric(seaiceareagraph1)
##Now we should be ready to plot!
plot(weathergooddates$Date, weathergraph1,
type = "l",
xlab = "Monthly Measurements from 1979-2023",
ylab = "Monthly Mean Temperatures at Palmer Station (°C)",
main = "Monthly Mean Temperatures at Palmer Station, 1979-2023",
col = "red")
abline(lm(weathergraph1 ~ weathergooddates$Date), col = "black", lwd = 2)
plot(seaicearea_WAPdates$Year, seaiceareagraph1,
type = "l",
xlab = "Monthly Measurements from 1979-2023",
ylab = "Monthly Sea Ice Area for WAP Region (km²)",
main = "Monthly Sea Ice Area for WAP Region, 1979-2023",
col = "blue")
abline(lm(seaiceareagraph1 ~ seaicearea_WAPdates$Year), col = "black", lwd = 2)
# Chunk 1: setup
knitr::opts_chunk$set(echo = TRUE)
# Chunk 2
##First, the cleaned .csv files are read into the global environment:
weather <- read.csv("Monthly_Weather_Clean.csv")
seaicearea <- read.csv("SeaIceArea_Clean.csv")
seaiceconc <- read.csv("SeaIceConc_Clean.csv")
##Then, we need to subset the data for mean temperatures for all years from 1979 to 2023, as these are the full years that we have data for (not parts of years):
weather_subset <- weather[, c("Date", "Mean_Temperature_C")]
View(weather_subset)
weather_subset$Date = as.Date(weather_subset$Date, format = "%m/%d/%Y")
weathergooddates <- weather_subset[weather_subset$Date >= as.Date("1979-01-01") & weather_subset$Date <= as.Date("2023-12-01"), ]
weathergooddates <- weather_subset[
weather_subset$Date >= as.Date("1979-01-01") &
weather_subset$Date <= as.Date("2023-12-01"),]
View(weathergooddates)
##Now, we need to do the same thing with the Sea Ice Area data, getting 1979 to 2023 area values for sea ice area for a specific region, here WAP:
seaicearea_WAP <- seaicearea[seaicearea$Subregion == "WAP", ]
View(seaicearea_WAP)
seaicearea_subsetWAP <- seaicearea_WAP[, c("Year", "Month", "Sea_ice_area")]
View(seaicearea_subsetWAP)
seaicearea_WAPdates <- seaicearea_subsetWAP[seaicearea_subsetWAP$Year >= 1979 & seaicearea_subsetWAP$Year <= 2023, ]
View(seaicearea_WAPdates)
##At this point, we end with the objects of weathergooddates and seaicearea_WAPdates, both of which have 540 variables for all months of 1979 and 2023. Because the entries already line up in both datasets, such as the second entry in both datasets corresponding to February 1979, I can now graph the 540 temp values in weathergooddates versus the years, and the 540 area values in seaicearea_WAPdates versus years and do trendlines separately:
weathergraph1 <- weathergooddates$Mean_Temperature_C
seaiceareagraph1 <- seaicearea_WAPdates$Sea_ice_area
##Both of the vectors we will graph have to be numerics, so check here!
seaiceareagraph1 <- as.numeric(seaiceareagraph1)
##Now we should be ready to plot!
plot(weathergooddates$Date, weathergraph1,
type = "l",
xlab = "Monthly Measurements from 1979-2023",
ylab = "Monthly Mean Temperatures at Palmer Station (°C)",
main = "Monthly Mean Temperatures at Palmer Station, 1979-2023",
col = "red")
abline(lm(weathergraph1 ~ weathergooddates$Date), col = "black", lwd = 2)
##------------------------------------------------------
plot(seaicearea_WAPdates$Year, seaiceareagraph1,
type = "l",
xlab = "Monthly Measurements from 1979-2023",
ylab = "Monthly Sea Ice Area for WAP Region (km²)",
main = "Monthly Sea Ice Area for WAP Region, 1979-2023",
col = "blue")
abline(lm(seaiceareagraph1 ~ seaicearea_WAPdates$Year), col = "black", lwd = 2)
##Now we have the trend of temperatures and sea ice area over time for the WAP region, spanning 1979 to 2023, which I think should be the focus of our analysis. Next will be to figure out how to either put the graphs together to see how the red and blue lines overlap, or plot the linear model trendlines directly to draw conclusions on what their relationship is.
plot(seaicearea_WAPdates$Year, seaiceareagraph1,
type = "l",
xlab = "Monthly Measurements from 1979-2023",
ylab = "Monthly Sea Ice Area for WAP Region (km²)",
main = "Monthly Sea Ice Area for WAP Region, 1979-2023",
col = "blue")
abline(lm(seaiceareagraph1 ~ seaicearea_WAPdates$Year), col = "black", lwd = 2)
