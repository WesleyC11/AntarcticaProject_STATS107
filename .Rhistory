remove_na <- function(df) { ## Automatize the removal of missing observations.
n_obs <- nrow(df)
missing <- rep(FALSE, n_obs)
for (obs_ind in 1:n_obs) {
obs <- df[obs_ind, ]
n_missing <- sum(is.na(obs))
if(n_missing > 0) {
missing[obs_ind] <- TRUE
}
}
df_red <- df[!missing, ]
return(df_red)
}
#######################################################
#######################################################
to_factors <- function(df) { ## Turn all character variables to factors.
n_vars <- ncol(df)
for (var_ind in 1:n_vars) {
var <- df[, var_ind]
if (class(var) == "character") {
df[, var_ind] <- factor(var)
}
}
return(df)
}
census <- read.csv("census.csv")
census <- remove_na(census)
census <- to_factors(census)
keep <- census$marital_status %in% c(
"Married/spouse absent",
"Married/spouse present",
"Never married/single"
)
census <- census[keep, ]
census$marital_status <- factor(ifelse(
census$marital_status == "Never married/single",
"Single",
"Married"
))
table(census$marital_status)
color_by_maritalstat <- ifelse(
census$marital_status == "Single",
"forestgreen",
"darkred"
)
pointstyle_by_maritalstat <- ifelse(
census$marital_status == "Single",
17,
8
)
table(color_by_maritalstat)
table(pointstyle_by_maritalstat)
colnames(census) <- c(
"Census Year",
"State",
"Total Family Income (USD)",
"Age (Years)",
"Sex",
"Race",
"Marital Status",
"Total Personal Income (USD)"
)
boxplot(
census[[3]] ~ census[[7]],
main = colnames(census)[3],
ylab = colnames(census)[3],
xlab = colnames(census)[7],
col = c("blue", "red")
)
## Insert code here:
numeric_vars <- c(1, 3, 4, 8)
par(mfrow = c(1, 4))
for (i in numeric_vars) {
boxplot(
census[[i]] ~ census[[7]],
main = colnames(census)[i],
ylab = colnames(census)[i],
xlab = "Marital Status",
col = c("red", "blue"),
cex.main = 0.7,
cex.lab = 0.7
)
}
par(mfrow = c(1, 1))
## Insert code here:
numeric_vars <- c(1, 3, 4, 8)
pairs(
census[, numeric_vars],
col = color_by_maritalstat,
pch = pointstyle_by_maritalstat,
main = "Census Data by Marital Status"
)
## Insert code here:
numeric_vars <- c(1, 3, 4, 8)
pairs(
census[, numeric_vars],
col = color_by_maritalstat,
pch = pointstyle_by_maritalstat,
main = "The Census Data Used to Compare by Marriage Status"
)
## Insert code here:
numeric_vars <- c(1, 3, 4, 8)
par(mfrow = c(1, 4))
for (i in numeric_vars) {
boxplot(
census[[i]] ~ census[[7]],
main = colnames(census)[i],
xlab = "Marital Status",
ylab = colnames(census)[i],
col = c("red", "blue"),
cex.main = 0.7,
cex.lab = 0.7
)
}
par(mfrow = c(1, 1))
View(census)
